<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fieldimage"
    tools:context=".screens.LoginActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="48dp"
        android:fontFamily="@font/secular_one_regular"
        android:text="התחברות"
        android:textColor="#F8F8FA"
        android:textSize="70dp"
        app:layout_constraintBottom_toTopOf="@+id/et_login_email"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_login_email"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="76dp"
        android:layout_marginEnd="76dp"
        android:layout_marginBottom="63dp"
        android:background="@drawable/edittext_rounded_bg"
        android:fontFamily="@font/secular_one_regular"
        android:hint="email"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintBottom_toTopOf="@+id/et_login_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <EditText
        android:id="@+id/et_login_password"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="76dp"
        android:layout_marginEnd="76dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/edittext_rounded_bg"
        android:fontFamily="@font/secular_one_regular"
        android:hint="password"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintBottom_toTopOf="@+id/tv_login_register"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_login_email" />

    <Button
        android:id="@+id/btn_login_login"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:layout_marginStart="71dp"
        android:layout_marginEnd="33dp"
        android:backgroundTint="#FFFFFF"
        android:fontFamily="@font/secular_one_regular"
        android:text="כניסה"
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_login_register"
        app:layout_constraintEnd_toStartOf="@+id/tv_login_register"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/tv_login_register"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:layout_marginEnd="63dp"
        android:layout_marginBottom="54dp"
        android:backgroundTint="#FFFFFF"
        android:fontFamily="@font/secular_one_regular"
        android:onClick="goRegister"
        android:text="הרשמה"
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_login_login"
        app:layout_constraintTop_toBottomOf="@+id/et_login_password"
        tools:ignore="OnClick" />

</androidx.constraintlayout.widget.ConstraintLayout>