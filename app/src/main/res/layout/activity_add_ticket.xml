<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.AddTicket">

    <TextView
        android:id="@+id/textticket"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="59dp"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="21dp"
        android:fontFamily="@font/secular_one_regular"
        android:text="הוספת כרטיס"
        android:textSize="60dp"
        app:layout_constraintBottom_toTopOf="@+id/spinnergames"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/text_Price"
        android:layout_width="200dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/secular_one_regular"
        android:hint="Price"
        app:layout_constraintBottom_toTopOf="@+id/text_Section"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinnergames" />

    <EditText
        android:id="@+id/text_Section"
        android:layout_width="200dp"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/secular_one_regular"
        android:hint="Section"
        app:layout_constraintBottom_toTopOf="@+id/text_Row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_Price" />

    <EditText
        android:id="@+id/text_Row"
        android:layout_width="200dp"
        android:layout_height="0dp"
        android:layout_marginBottom="11dp"
        android:fontFamily="@font/secular_one_regular"
        android:hint="Row"
        app:layout_constraintBottom_toTopOf="@+id/text_Seat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_Section" />

    <EditText
        android:id="@+id/text_Seat"
        android:layout_width="200dp"
        android:layout_height="0dp"
        android:layout_marginBottom="15dp"
        android:fontFamily="@font/secular_one_regular"
        android:hint="Seat"
        app:layout_constraintBottom_toTopOf="@+id/text_Currency"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_Row" />

    <EditText
        android:id="@+id/text_Currency"
        android:layout_width="200dp"
        android:layout_height="0dp"
        android:layout_marginBottom="19dp"
        android:fontFamily="@font/secular_one_regular"
        android:hint="Currency"
        app:layout_constraintBottom_toTopOf="@+id/text_IsAvailable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_Seat" />

    <EditText
        android:id="@+id/text_IsAvailable"
        android:layout_width="200dp"
        android:layout_height="0dp"
        android:layout_marginBottom="22dp"
        android:fontFamily="@font/secular_one_regular"
        android:hint="Is available?"
        app:layout_constraintBottom_toTopOf="@+id/backToUser"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_Currency" />

    <Button
        android:id="@+id/btnAddTick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="27dp"
        android:fontFamily="@font/secular_one_regular"
        android:text="הוסף"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/backToUser"
        app:layout_constraintTop_toBottomOf="@+id/spinnergames" />

    <Button
        android:id="@+id/backToUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="27dp"
        android:fontFamily="@font/secular_one_regular"
        android:text="חזרה"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnAddTick"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_IsAvailable" />

    <Spinner
        android:id="@+id/spinnergames"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="155dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="445dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAddTick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>