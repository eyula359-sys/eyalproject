<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fieldimage"
    tools:context=".screens.UserActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:layout_marginTop="57dp"
        android:layout_marginEnd="54dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/edittext_rounded_bg"
        android:fontFamily="@font/secular_one_regular"
        android:gravity="center"
        android:text="דף משתמש"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="50dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAddTicket"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnAddTicket"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="הוספת כרטיס למכירה"
        android:textSize="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSearchTicket"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <Button
        android:id="@+id/btnSearchTicket"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:layout_marginBottom="22dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="חיפוש כרטיסים"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/btnMyProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAddTicket" />

    <Button
        android:id="@+id/btnMyProfile"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:onClick="goUserProfile"
        android:text="My profile"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/btnMyTickets"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSearchTicket" />

    <Button
        android:id="@+id/btnMyTickets"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:layout_marginBottom="21dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="הכרטיסים שהוספתי"
        android:textSize="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnFavoriteTickets"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnMyProfile" />

    <Button
        android:id="@+id/btnFavoriteTickets"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:layout_marginBottom="65dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="כרטיסים מועדפים ❤️"
        android:textSize="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnGoToBuyer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnMyTickets" />

    <Button
        android:id="@+id/btnGoToBuyer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="51dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="הכרטיסים שקניתי"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnGoToOwner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnFavoriteTickets" />

    <Button
        android:id="@+id/btnGoToOwner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="54dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="הכרטיסים שמכרתי"
        android:textSize="16dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/btnGoToBuyer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnGoToBuyer" />

</androidx.constraintlayout.widget.ConstraintLayout>