<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fieldimage"
    tools:context=".screens.UserActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="62dp"
        android:layout_marginBottom="75dp"
        android:background="@drawable/edittext_rounded_bg"
        android:fontFamily="@font/secular_one_regular"
        android:text="דף משתמש"
        android:textColor="@color/white"
        android:textSize="60dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAddTicket"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnAddTicket"
        android:layout_width="193dp"
        android:layout_height="0dp"
        android:layout_marginBottom="25dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="הוספת כרטיס למכירה"
        android:textSize="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSearchTicket"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <Button
        android:id="@+id/btnSearchTicket"
        android:layout_width="193dp"
        android:layout_height="0dp"
        android:layout_marginBottom="25dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="חיפוש כרטיסים"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/btnMyProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAddTicket" />

    <Button
        android:id="@+id/btnMyProfile"
        android:layout_width="193dp"
        android:layout_height="0dp"
        android:layout_marginBottom="11dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:onClick="goUserProfile"
        android:text="My profile"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/btnMyTickets"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSearchTicket" />

    <Button
        android:id="@+id/btnMyTickets"
        android:layout_width="193dp"
        android:layout_height="0dp"
        android:layout_marginBottom="11dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="הכרטיסים שהוספתי"
        android:textSize="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnFavoriteTickets"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnMyProfile" />

    <Button
        android:id="@+id/btnFavoriteTickets"
        android:layout_width="193dp"
        android:layout_height="0dp"
        android:layout_marginBottom="186dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="כרטיסים מועדפים ❤️"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnMyTickets" />

</androidx.constraintlayout.widget.ConstraintLayout>