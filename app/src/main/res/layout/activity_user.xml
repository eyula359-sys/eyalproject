<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fieldimage"
    tools:context=".screens.UserActivity">


    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="43dp"
        android:layout_marginBottom="63dp"
        android:background="@drawable/edittext_rounded_bg"
        android:fontFamily="@font/secular_one_regular"
        android:text="דף משתמש"
        android:textColor="@color/white"
        android:textSize="60dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAddTicket"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnAddTicket"
        android:layout_width="193dp"
        android:layout_height="0dp"
        android:layout_marginBottom="27dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="הוספת כרטיס"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/btnMyTickets"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <Button
        android:id="@+id/btnMyTickets"
        android:layout_width="193dp"
        android:layout_height="0dp"
        android:layout_marginBottom="22dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="הכרטיסים שלי"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSearchTicket"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAddTicket" />

    <Button
        android:id="@+id/btnSearchTicket"
        android:layout_width="193dp"
        android:layout_height="0dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="חיפוש כרטיסים"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/btnMyProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnMyTickets" />

    <Button
        android:id="@+id/btnMyProfile"
        android:layout_width="193dp"
        android:layout_height="0dp"
        android:layout_marginBottom="112dp"
        android:backgroundTint="#E4360E"
        android:fontFamily="@font/secular_one_regular"
        android:text="My profile"
        android:textSize="18dp"
        android:onClick="goUserProfile"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSearchTicket" />


</androidx.constraintlayout.widget.ConstraintLayout>